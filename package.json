{
    "name": "@hodfords/nestjs-transaction",
    "version": "12.4.0",
    "packageManager": "pnpm@12.0.0",
    "description": "Manages database transactions in NestJS applications",
    "main": "./index.js",
    "scripts": {
        "prebuild": "rimraf dist *.tsbuildinfo",
        "build": "tsc -p tsconfig.build.json",
        "cspell": "cspell",
        "format": "prettier --write \"sample/**/*.ts\" \"lib/**/*.ts\"",
        "postbuild": "cp package.json dist/lib && cp README.md dist/lib && cp .npmrc dist/lib",
        "lint": "eslint \"{sample,lib,test}/**/*.ts\" --fix",
        "lint-staged": "lint-staged",
        "prepare": "is-ci || husky",
        "release:patch": "git add CHANGELOG.md && pnpm version patch --tag-version-prefix='' -f -m 'chore: release to %s'",
        "release:push": "git push --no-verify && git push --tags --no-verify",
        "start": "nest start",
        "start:debug": "nest start --debug --watch",
        "start:dev": "pnpm run prebuild && nest start --watch",
        "test": "vitest run",
        "test:cov": "vitest run --coverage",
        "test:watch": "vitest"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/hodfords-solutions/nestjs-transaction.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/hodfords-solutions/nestjs-transaction/issues"
    },
    "homepage": "https://github.com/hodfords-solutions/nestjs-transaction#readme",
    "devDependencies": {
        "@hodfords/nestjs-eslint-config": "^11.0.4",
        "@hodfords/nestjs-prettier-config": "^11.0.2",
        "@hodfords/typeorm-helper": "12.1.0",
        "@nestjs/cli": "12.0.0",
        "@nestjs/common": "12.0.1",
        "@nestjs/core": "12.0.1",
        "@nestjs/platform-express": "12.0.1",
        "@nestjs/swagger": "12.0.1",
        "@nestjs/testing": "12.0.1",
        "@nestjs/typeorm": "12.0.1",
        "@swc/core": "^1.16.1",
        "@types/lodash": "4.17.25",
        "@types/node": "26.4.0",
        "class-transformer": "0.5.1",
        "class-validator": "npm:@hodfords/turbo-validator@1.0.0",
        "commander": "15.0.0",
        "cspell": "10.1.1",
        "eslint": "10.9.1",
        "husky": "9.1.7",
        "is-ci": "4.1.0",
        "lint-staged": "17.4.1",
        "lodash": "4.18.1",
        "mongodb": "7.6.0",
        "nestjs-cls": "6.3.0",
        "pg": "8.23.0",
        "prettier": "3.9.6",
        "reflect-metadata": "0.2.2",
        "rimraf": "6.1.3",
        "rxjs": "7.8.2",
        "typeorm": "1.1.0",
        "typescript": "6.0.3",
        "unplugin-swc": "^1.5.11",
        "vitest": "^4.1.11"
    },
    "peerDependencies": {
        "@hodfords/typeorm-helper": ">=12.0.0",
        "@nestjs/common": ">=12.0.0",
        "@nestjs/core": ">=12.0.0",
        "nestjs-cls": "*",
        "rxjs": ">=7.0.0",
        "typeorm": ">=1.0.0"
    },
    "peerDependenciesMeta": {
        "rxjs": {
            "optional": true
        }
    },
    "optionalDependencies": {
        "mongodb": "^7.6.0"
    },
    "type": "module",
    "types": "./index.d.ts",
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "import": "./index.js",
            "default": "./index.js"
        },
        "./package.json": "./package.json"
    },
    "engines": {
        "node": ">=20.19.0"
    }
}
