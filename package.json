{
    "name": "@hodfords/nestjs-transaction",
    "version": "11.4.2",
    "description": "Manages database transactions in NestJS applications",
    "main": "./index.js",
    "scripts": {
        "prebuild": "rimraf dist",
        "build": "tsc -p tsconfig.build.json",
        "cspell": "cspell",
        "format": "prettier --write \"sample/**/*.ts\" \"lib/**/*.ts\"",
        "postbuild": "cp package.json dist/lib && cp README.md dist/lib && cp .npmrc dist/lib",
        "lint": "eslint \"{sample,lib,test}/**/*.ts\" --fix",
        "lint-staged": "lint-staged",
        "prepare": "is-ci || husky",
        "release:patch": "git add CHANGELOG.md && npm version patch --tag-version-prefix='' -f -m 'chore: release to %s'",
        "release:push": "git push --no-verify && git push --tags --no-verify",
        "start": "nest start",
        "start:debug": "nest start --debug --watch",
        "start:dev": "npm run prebuild && nest start --watch",
        "test": "vitest run",
        "test:cov": "vitest run --coverage",
        "test:watch": "vitest"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/hodfords-solutions/nestjs-transaction.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/hodfords-solutions/nestjs-transaction/issues"
    },
    "homepage": "https://github.com/hodfords-solutions/nestjs-transaction#readme",
    "devDependencies": {
        "@hodfords/nestjs-eslint-config": "^11.0.4",
        "@hodfords/nestjs-prettier-config": "^11.0.2",
        "@hodfords/typeorm-helper": "11.2.0",
        "@nestjs/cli": "12.0.0",
        "@nestjs/common": "12.0.1",
        "@nestjs/core": "12.0.1",
        "@nestjs/platform-express": "12.0.1",
        "@nestjs/swagger": "12.0.0",
        "@nestjs/testing": "12.0.1",
        "@nestjs/typeorm": "11.0.2",
        "@swc/core": "^1.13.5",
        "@types/lodash": "4.17.16",
        "@types/node": "25.2.0",
        "class-transformer": "0.5.1",
        "class-validator": "0.14.1",
        "commander": "13.1.0",
        "cspell": "8.17.5",
        "eslint": "9.22.0",
        "husky": "9.1.7",
        "is-ci": "4.1.0",
        "lint-staged": "15.5.0",
        "lodash": "4.17.21",
        "mongodb": "7.3.0",
        "nestjs-cls": "6.0.1",
        "pg": "8.14.1",
        "prettier": "3.5.3",
        "reflect-metadata": "0.2.2",
        "rimraf": "6.0.1",
        "rxjs": "7.8.2",
        "typeorm": "1.1.0",
        "typescript": "5.9.3",
        "unplugin-swc": "^1.5.7",
        "vitest": "^4.1.10"
    },
    "dependencies": {
        "nestjs-cls": "*"
    },
    "peerDependencies": {
        "nestjs-cls": "*"
    },
    "optionalDependencies": {
        "mongodb": "^7.0.0"
    },
    "type": "module",
    "types": "./index.d.ts",
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "import": "./index.js",
            "default": "./index.js"
        },
        "./package.json": "./package.json"
    },
    "engines": {
        "node": ">=20.19.0"
    },
    "overrides": {
        "nestjs-cls": {
            "@nestjs/common": "$@nestjs/common",
            "@nestjs/core": "$@nestjs/core"
        },
        "@nestjs/typeorm": {
            "@nestjs/common": "$@nestjs/common",
            "@nestjs/core": "$@nestjs/core",
            "typeorm": "$typeorm"
        },
        "@hodfords/typeorm-helper": {
            "@nestjs/common": "$@nestjs/common",
            "@nestjs/core": "$@nestjs/core",
            "typeorm": "$typeorm"
        },
        "ioredis": "^5.8.2"
    }
}
