{
    "compilerOptions": {
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "target": "es2023",
        "strictPropertyInitialization": false,
        "types": ["node"],
        "lib": ["es2023"],
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "declaration": true,
        "removeComments": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "sourceMap": true,
        "skipLibCheck": true,
        "outDir": "dist",
        "incremental": true,
        "paths": {
            "@hodfords/nestjs-transaction": ["./lib/index.ts"]
        }
    },
    "include": ["lib", "sample", "test"],
    "exclude": ["dist", "node_modules"]
}
